Q.1  Food Delivery System

class Customer {
    String name;
    String address;
    String phone;
}

class Restaurant {
    String name;
    String location;
    String[] menu;
}

class DeliveryBoy {
    String name;
    String vehicleNumber;
}

class Order {
    Customer customer;         
    Restaurant restaurant;     
    DeliveryBoy deliveryBoy;   
    String foodItem;
    double price;

    void placeOrder() {
        print("Order placed by " + customer.name + 
              " from " + restaurant.name +
              " delivered by " + deliveryBoy.name);
    }
}

class FoodDeliverySystem {
    public static void main(String[] args) {
        Customer c = new Customer("Amit", "Delhi", "9876543210");
        Restaurant r = new Restaurant("PizzaHub", "Noida", ["Pizza", "Burger"]);
        DeliveryBoy d = new DeliveryBoy("Rohit", "UP32AB1234");

        Order order = new Order(c, r, d, "Pizza", 299.0);
        order.placeOrder();
    }
}




Q.2 Mwdical Record Manager 

INTERFACE Searchable
    METHOD search(keyword) → returns boolean
INTERFACE Printable
    METHOD print()
CLASS PatientReport IMPLEMENTS Searchable, Printable
    ATTRIBUTES: patientName, disease
    METHOD search(keyword)
        RETURN keyword IN patientName OR keyword IN disease
    METHOD print()
        PRINT "Patient Report: " + patientName + " | Disease: " + disease
CLASS DoctorReport IMPLEMENTS Searchable, Printable
    ATTRIBUTES: doctorName, specialization
    METHOD search(keyword)
        RETURN keyword IN doctorName OR keyword IN specialization
    METHOD print()
        PRINT "Doctor Report: " + doctorName + " | Specialization: " + specialization
MAIN PROGRAM
    report1 = PatientReport("Rahul", "Flu")
    report2 = DoctorReport("Dr. Mehta", "Cardiology")
    report1.print()   // Polymorphism: Printable reference
    report2.print()
    IF report1.search("Flu") THEN
        PRINT "Match found in Patient Report"
    ENDIF
