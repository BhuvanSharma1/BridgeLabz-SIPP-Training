Q1:Traffic Signal Simulation

Enum TrafficLight { RED, YELLOW, GREEN }

Class TrafficSignal
    Attribute currentLight : TrafficLight

    Constructor()
        currentLight = RED
    
    Method switchLight()
        if currentLight == RED
            currentLight = GREEN
        else if currentLight == GREEN
            currentLight = YELLOW
        else if currentLight == YELLOW
            currentLight = RED
    
    Method showLight()
        print "Current Signal: " + currentLight

Main
    Create object signal = new TrafficSignal()
    Loop 5 times
        signal.showLight()
        wait 2 seconds
        signal.switchLight()

Q2:Smart Farming Systemw 

Abstract Class Crop
    Attribute name : String
    Abstract Method waterRequirement()
    Abstract Method harvestTime()

Class Rice extends Crop
    Method waterRequirement()
        return "High water needed (e.g., 1200mm)"
    Method harvestTime()
        return "4 months"

Class Wheat extends Crop
    Method waterRequirement()
        return "Moderate water needed (e.g., 600mm)"
    Method harvestTime()
        return "6 months"

Main
    Create crop1 = new Rice()
    print "Rice Water Requirement: " + crop1.waterRequirement()
